# =============================================================================
# Copiez ce fichier en « .env » puis ajustez les valeurs :
#
#     cp .env.example .env
#
# Docker Compose lit « .env » automatiquement. Le serveur le lit aussi au
# lancement direct (npm start). Les variables deja definies dans
# l'environnement ont toujours la priorite sur ce fichier.
# Toutes les lignes sont facultatives : les valeurs ci-dessous sont les defauts.
# =============================================================================

# --- Ports -------------------------------------------------------------------

# Port d'ecoute de l'application, a l'interieur du conteneur.
# C'est le port a indiquer au reverse proxy (Traefik / Dokploy).
# A laisser tel quel dans la plupart des cas.
PORT=3000

# Port publie sur la machine hote. Sert UNIQUEMENT en test local, avec :
#     docker compose -f docker-compose.yml -f docker-compose.local.yml up -d
# Le fichier docker-compose.yml seul ne publie aucun port : derriere un reverse
# proxy, c'est inutile et ca provoque des conflits « port is already allocated ».
APP_PORT=3000

# --- Caches ------------------------------------------------------------------

# Duree de vie du cache des prix, en secondes.
# Le flux officiel n'est mis a jour que quelques fois par jour : descendre
# en dessous de 600 s n'apporte rien et sollicite la source pour rien.
PRICES_TTL_SECONDS=1200

# Duree de vie du referentiel des enseignes, en secondes (il bouge tres peu).
BRANDS_TTL_SECONDS=86400

# Cache court des reponses /api/stations, en secondes.
QUERY_TTL_SECONDS=60

# Delai maximal d'une requete vers une source de donnees, en millisecondes.
FETCH_TIMEOUT_MS=60000

# --- Requetes geographiques --------------------------------------------------

# Rayon de recherche « autour de moi », en kilometres.
DEFAULT_RADIUS_KM=15

# Rayon maximal accepte par l'API, en kilometres.
MAX_RADIUS_KM=50

# Nombre maximal de stations renvoyees en une reponse.
MAX_RESULTS=300
